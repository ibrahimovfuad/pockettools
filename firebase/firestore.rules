rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Small validation helpers. d is the document being written (request.resource.data), k a field name.
    function str(d, k, max) { return d[k] is string && d[k].size() > 0 && d[k].size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optNum(d, k) { return !(k in d) || d[k] is number; }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function optStrNum(d, k, max) { return !(k in d) || d[k] is number || (d[k] is string && d[k].size() <= max); }

    // Mood: day ratings
    match /users/{uid}/days/{day} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['score', 'note', 'updatedAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
    }

    // Habits: one document per habit. freq is {type: 'days', days: [0..6]} or {type: 'weekly', times: n}.
    function validFreq(f) {
      return f is map && f.keys().hasOnly(['type', 'days', 'times'])
        && (!('type' in f) || f.type in ['days', 'weekly'])
        && (!('days' in f) || (f.days is list && f.days.size() <= 7))
        && optNum(f, 'times');
    }
    match /users/{uid}/habits/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'emoji', 'color', 'freq', 'target', 'unit', 'archived', 'start', 'created', 'kind'])
        && str(request.resource.data, 'name', 60)
        && optStr(request.resource.data, 'emoji', 32)
        && optStr(request.resource.data, 'unit', 20)
        && optStr(request.resource.data, 'start', 10)
        && optNum(request.resource.data, 'color') && optNum(request.resource.data, 'target') && optNum(request.resource.data, 'created')
        && optBool(request.resource.data, 'archived')
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['build', 'quit'])
        && (!('freq' in request.resource.data) || validFreq(request.resource.data.freq));
    }

    // Habit check-ins: one document per habit and year (id "<habitId>_<year>"). d maps "MM-DD" to the count for that
    // day and n maps "MM-DD" to a note, so each holds at most 366 entries.
    match /users/{uid}/logs/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && id.size() <= 120
        && request.resource.data.keys().hasOnly(['habitId', 'year', 'd', 'n'])
        && str(request.resource.data, 'habitId', 100)
        && (!('year' in request.resource.data) || (request.resource.data.year is int && request.resource.data.year >= 1900 && request.resource.data.year <= 2200))
        && (!('d' in request.resource.data) || (request.resource.data.d is map && request.resource.data.d.size() <= 400))
        && (!('n' in request.resource.data) || (request.resource.data.n is map && request.resource.data.n.size() <= 400));
    }

    // Bookshelf: the profile holds the settings of the friends link ({share: {on, id, showR, showQ}}); the app writes
    // nothing else. Extra top-level fields are tolerated (up to 8) so that an older profile document never blocks a save.
    // Reading is "get" only: nobody lists the users collection.
    function validShare(s) {
      return s is map && s.size() <= 8
        && optBool(s, 'on') && optBool(s, 'showR') && optBool(s, 'showQ')
        && (!('id' in s) || (s.id is string && s.id.matches('^[A-Za-z0-9]{4,32}$')));
    }
    match /users/{uid} {
      allow get, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().size() <= 8
        && (!('share' in request.resource.data) || validShare(request.resource.data.share));
    }
    // Books: the fields the app writes (title is the only required one). Free text is capped generously;
    // year and pages are strings or numbers because book databases return either.
    match /users/{uid}/books/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['title', 'author', 'genre', 'year', 'pages', 'format', 'isbn', 'cover', 'desc', 'status', 'start', 'end', 'rating', 'review', 'why', 'order', 'created', 'updated', 'looked'])
        && str(request.resource.data, 'title', 300)
        && optStr(request.resource.data, 'author', 500)
        && optStr(request.resource.data, 'genre', 100)
        && optStr(request.resource.data, 'format', 40)
        && optStr(request.resource.data, 'isbn', 40)
        && optStr(request.resource.data, 'cover', 8000)
        && optStr(request.resource.data, 'desc', 20000)
        && optStr(request.resource.data, 'review', 20000)
        && optStr(request.resource.data, 'why', 5000)
        && optStr(request.resource.data, 'start', 20)
        && optStr(request.resource.data, 'end', 20)
        && optStrNum(request.resource.data, 'year', 20)
        && optStrNum(request.resource.data, 'pages', 20)
        && (!('status' in request.resource.data) || request.resource.data.status in ['queue', 'reading', 'done', 'dropped'])
        && (!('rating' in request.resource.data) || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5))
        && optNum(request.resource.data, 'order') && optNum(request.resource.data, 'created') && optNum(request.resource.data, 'updated')
        && optBool(request.resource.data, 'looked');
    }
    match /users/{uid}/quotes/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['bookId', 'page', 'text', 'created', 'updated'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && optStr(request.resource.data, 'bookId', 100)
        && optStrNum(request.resource.data, 'page', 20)
        && optNum(request.resource.data, 'created') && optNum(request.resource.data, 'updated');
    }

    // Spend: categories, expenses and one settings document (budget, merchant rules)
    match /users/{uid}/spend_categories/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'icon', 'color', 'order'])
        && str(request.resource.data, 'name', 40)
        && optStr(request.resource.data, 'icon', 40)
        && optStr(request.resource.data, 'color', 20)
        && optNum(request.resource.data, 'order');
    }
    match /users/{uid}/spend_expenses/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['amount', 'catId', 'note', 'date', 'ts', 'merchant', 'source'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && str(request.resource.data, 'catId', 100)
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optNum(request.resource.data, 'ts')
        && optStr(request.resource.data, 'note', 500)
        && optStr(request.resource.data, 'merchant', 100)
        && optStr(request.resource.data, 'source', 20);
    }
    match /users/{uid}/spend_meta/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && id == 'settings'
        && request.resource.data.keys().hasOnly(['budget', 'rules'])
        && (!('budget' in request.resource.data) || request.resource.data.budget == null || request.resource.data.budget is number)
        && (!('rules' in request.resource.data) || (request.resource.data.rules is map && request.resource.data.rules.size() <= 500));
    }

    // Mood: the user's one-time consent to store entries in the cloud (a single document, id "consent").
    // "at" is the time of consent in milliseconds, "version" the consent text version the user agreed to.
    match /users/{uid}/mood_consent/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && id == 'consent'
        && request.resource.data.keys().hasOnly(['at', 'version'])
        && request.resource.data.keys().hasAll(['at', 'version'])
        && request.resource.data.at is number
        && request.resource.data.version is int
        && request.resource.data.version > 0 && request.resource.data.version < 1000;
    }

    // Weekly Digest: one small snapshot per ISO week (id like 2026-W47). The app counts the quotes
    // at each visit so it can tell how many were removed (deleted documents leave no trace).
    match /users/{uid}/digest_weeks/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && id.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['quotes', 'removed', 'ts'])
        && request.resource.data.keys().hasAll(['quotes', 'ts'])
        && request.resource.data.quotes is int
        && request.resource.data.quotes >= 0 && request.resource.data.quotes < 1000000
        && (!('removed' in request.resource.data)
            || (request.resource.data.removed is int && request.resource.data.removed >= 0 && request.resource.data.removed < 1000000))
        && request.resource.data.ts is number;
    }

    // Routes: saved places, the last 10 searches and settings. Only what the user saves — no trips, no location history.
    match /users/{uid}/routes_places/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && id.matches('^[A-Za-z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['kind', 'name', 'sub', 'lat', 'lon', 'stopId', 'ts'])
        && request.resource.data.keys().hasAll(['kind', 'name', 'lat', 'lon'])
        && request.resource.data.kind in ['home', 'work', 'stop', 'place']
        && str(request.resource.data, 'name', 120)
        && optStr(request.resource.data, 'sub', 200)
        && optStr(request.resource.data, 'stopId', 200)
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lon is number && request.resource.data.lon >= -180 && request.resource.data.lon <= 180
        && optNum(request.resource.data, 'ts');
    }
    match /users/{uid}/routes_meta/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && (
        (id == 'settings'
          && request.resource.data.keys().hasOnly(['direction', 'rotate', 'live', 'city', 'ts'])
          && (!('direction' in request.resource.data) || request.resource.data.direction is bool)
          && (!('rotate' in request.resource.data) || request.resource.data.rotate is bool)
          && (!('live' in request.resource.data) || request.resource.data.live is bool)
          && optStr(request.resource.data, 'city', 40)
          && optNum(request.resource.data, 'ts'))
        || (id == 'history'
          && request.resource.data.keys().hasOnly(['items', 'ts'])
          && request.resource.data.keys().hasAll(['items'])
          && request.resource.data.items is list && request.resource.data.items.size() <= 10
          && optNum(request.resource.data, 'ts')));
    }

    // Lightmeter (removed app): its collections can still be read and deleted by their owner (export and "Delete account"
    // need that), but nothing can be written any more.
    match /users/{uid}/lm_cameras/{id} { allow read, delete: if owner(uid); }
    match /users/{uid}/lm_lenses/{id} { allow read, delete: if owner(uid); }
    match /users/{uid}/lm_films/{id} { allow read, delete: if owner(uid); }
    match /users/{uid}/lm_rolls/{id} { allow read, delete: if owner(uid); }
    match /users/{uid}/lm_frames/{id} { allow read, delete: if owner(uid); }

    // Bookshelf friends link: a read-only copy of a shelf, opened without signing in by its exact id. Nobody can list
    // the collection, except that a signed-in owner can list their own shelves (where uid == their uid): "Delete account"
    // uses that to find shelves left over from earlier links.
    // "uid" is stored so that the rules can tell who owns a shelf; it is visible to whoever has the link.
    // Ids are the random codes the app generates (letters and digits, 4 to 32 characters).
    function validPublic(id, d) {
      return id.matches('^[A-Za-z0-9]{4,32}$')
        && d.keys().hasOnly(['uid', 'name', 'photo', 'showR', 'showQ', 'updated', 'books', 'quotes'])
        && d.keys().hasAll(['uid'])
        && optStr(d, 'name', 100) && optStr(d, 'photo', 1000)
        && optBool(d, 'showR') && optBool(d, 'showQ') && optNum(d, 'updated')
        && (!('books' in d) || (d.books is list && d.books.size() <= 5000))
        && (!('quotes' in d) || (d.quotes is list && d.quotes.size() <= 10000));
    }
    match /public/{id} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && validPublic(id, request.resource.data);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && validPublic(id, request.resource.data);
      // Deleting a shelf that does not exist is a no-op, so it is allowed: without this, turning a link off (or Delete
      // account) fails with "permission denied" when the shelf was never published or is already gone.
      allow delete: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
