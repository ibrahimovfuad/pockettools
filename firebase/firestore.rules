rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Настроение: оценки дней
    match /users/{uid}/days/{day} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['score', 'note', 'updatedAt'])
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000));
    }

    // Привычки
    match /users/{uid}/habits/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
    }

    // Отметки привычек: один документ на привычку за год
    match /users/{uid}/logs/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.habitId is string;
    }
  
    // Полка: профиль (настройки ссылки для друзей), книги и цитаты
    match /users/{uid} {
      allow read, write: if owner(uid);
    }
    match /users/{uid}/books/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 300;
    }
    match /users/{uid}/quotes/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
    }

    // Spend: categories, expenses and one settings document (budget, merchant rules)
    function str(d, k, max) { return d[k] is string && d[k].size() > 0 && d[k].size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optNum(d, k) { return !(k in d) || d[k] is number; }
    match /users/{uid}/spend_categories/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'icon', 'color', 'order'])
        && str(request.resource.data, 'name', 40)
        && optStr(request.resource.data, 'icon', 40)
        && optStr(request.resource.data, 'color', 20)
        && optNum(request.resource.data, 'order');
    }
    match /users/{uid}/spend_expenses/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['amount', 'catId', 'note', 'date', 'ts', 'merchant', 'source'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && str(request.resource.data, 'catId', 100)
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optNum(request.resource.data, 'ts')
        && optStr(request.resource.data, 'note', 500)
        && optStr(request.resource.data, 'merchant', 100)
        && optStr(request.resource.data, 'source', 20);
    }
    match /users/{uid}/spend_meta/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && id == 'settings'
        && request.resource.data.keys().hasOnly(['budget', 'rules'])
        && (!('budget' in request.resource.data) || request.resource.data.budget == null || request.resource.data.budget is number)
        && (!('rules' in request.resource.data) || (request.resource.data.rules is map && request.resource.data.rules.size() <= 500));
    }

    // Weekly Digest: one small snapshot per ISO week (id like 2026-W47). The app counts the quotes
    // at each visit so it can tell how many were removed (deleted documents leave no trace).
    match /users/{uid}/digest_weeks/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && id.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['quotes', 'removed', 'ts'])
        && request.resource.data.keys().hasAll(['quotes', 'ts'])
        && request.resource.data.quotes is int
        && request.resource.data.quotes >= 0 && request.resource.data.quotes < 1000000
        && (!('removed' in request.resource.data)
            || (request.resource.data.removed is int && request.resource.data.removed >= 0 && request.resource.data.removed < 1000000))
        && request.resource.data.ts is number;
    }

    // Lightmeter: gear, rolls of film and the frames logged on them
    match /users/{uid}/lm_cameras/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'fastest', 'slowest'])
        && str(request.resource.data, 'name', 40)
        && request.resource.data.fastest is number && request.resource.data.slowest is number;
    }
    match /users/{uid}/lm_lenses/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'focal', 'widest', 'smallest'])
        && str(request.resource.data, 'name', 40)
        && request.resource.data.widest is number && request.resource.data.smallest is number
        && optNum(request.resource.data, 'focal');
    }
    match /users/{uid}/lm_films/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'iso', 'exposures'])
        && str(request.resource.data, 'name', 40)
        && request.resource.data.iso is number
        && request.resource.data.exposures is int && request.resource.data.exposures > 0 && request.resource.data.exposures < 1000;
    }
    match /users/{uid}/lm_rolls/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['filmId', 'filmName', 'iso', 'exposures', 'started', 'finished', 'status', 'ts', 'cameraId', 'cameraName'])
        && str(request.resource.data, 'filmName', 40)
        && request.resource.data.iso is number && request.resource.data.exposures is int
        && request.resource.data.status in ['loaded', 'finished']
        && optStr(request.resource.data, 'filmId', 100) && optStr(request.resource.data, 'cameraId', 100)
        && optStr(request.resource.data, 'cameraName', 40)
        && optStr(request.resource.data, 'started', 10) && optStr(request.resource.data, 'finished', 10)
        && optNum(request.resource.data, 'ts');
    }
    match /users/{uid}/lm_frames/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['rollId', 'n', 'aperture', 'shutter', 'iso', 'ev', 'dev', 'lensId', 'ts', 'lat', 'lng', 'note'])
        && str(request.resource.data, 'rollId', 100)
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n < 1000
        && request.resource.data.aperture is number && request.resource.data.shutter is number
        && request.resource.data.iso is number && request.resource.data.ev is number
        && optNum(request.resource.data, 'dev') && optNum(request.resource.data, 'ts')
        && optNum(request.resource.data, 'lat') && optNum(request.resource.data, 'lng')
        && optStr(request.resource.data, 'lensId', 100)
        && optStr(request.resource.data, 'note', 300);
    }

    // Полка для друзей: копия только для чтения, открывается по ссылке без входа.
    // Списком документы получить нельзя — только зная точный код из ссылки.
    match /public/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
