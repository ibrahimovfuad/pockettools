# Content-Security-Policy on the app's own pages: no inline scripts (this also keeps the Netlify badge from being injected),
# no plugins, no <base> tricks, no form posts to other sites, no embedding. Set on "/" and "/index.html" only, so that
# proxied pages (such as Firebase's /__/auth/*) never get it. With --firebase, new-app adds the Google hosts for sign-in.
/
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/index.html
  Content-Security-Policy: script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
