# Disallow inline scripts on app pages — this also keeps the Netlify badge from being injected.
# Google hosts are needed for Firebase sign-in, 'wasm-unsafe-eval' for the barcode scanner.
/
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com https://www.google.com
/index.html
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com https://www.google.com
/u/*
  Content-Security-Policy: script-src 'self' 'wasm-unsafe-eval' https://apis.google.com https://www.gstatic.com https://www.google.com
  X-Robots-Tag: noindex
/zxing_reader.wasm
  Content-Type: application/wasm
